# GNU makefile: Search.VPlug (Voyager Search Central plugin) with m68k-amigaos-gcc
#
# make -f makefile.gcc          builds objects/gcc/Search.VPlug (and .debug)
# make -f makefile.gcc clean
#
# The library entry comes from ../libstart_gcc.c, stccpy/stpblk/stch_l
# from ../sasc_compat.c.

CROSS    ?= m68k-amigaos-
CC       = $(CROSS)gcc
STRIP    = $(CROSS)strip
CPU      ?= 68020

OBJDIR   = objects/gcc
TARGET   = $(OBJDIR)/Search.VPlug

# romtag version from rev.h
LIBVERSION := $(shell awk '/^\#define VERSION[ \t]+[0-9]+[ \t]*$$/ { print $$3 }' rev.h)

INCLUDES = -I. -I.. -I../pluginapi -I../includestuff
CFLAGS   = -noixemul -m$(CPU) -Os -fomit-frame-pointer -funsigned-char \
	-fno-strict-aliasing -fcommon -Wall -Wno-pointer-sign \
	-Werror=implicit-function-declaration -DAMIGAOS $(INCLUDES)
LDFLAGS  = -noixemul -m$(CPU) -nostartfiles
LIBS     = -lamiga

OBJS = $(OBJDIR)/libstart_gcc.o $(OBJDIR)/search.o $(OBJDIR)/sasc_compat.o

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(LDFLAGS) -o $(TARGET).debug $(OBJS) $(LIBS)
	$(STRIP) -o $@ $(TARGET).debug

$(OBJDIR)/libstart_gcc.o: ../libstart_gcc.c ../libstart_gcc.h rev.h
	@mkdir -p $(OBJDIR)
	$(CC) $(CFLAGS) -fno-toplevel-reorder -DLIB_VERSION=$(LIBVERSION) -c $< -o $@

$(OBJDIR)/search.o: search.c rev.h ../libstart_gcc.h ../sasc_compat.h
	@mkdir -p $(OBJDIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/sasc_compat.o: ../sasc_compat.c ../sasc_compat.h
	@mkdir -p $(OBJDIR)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(OBJDIR)
