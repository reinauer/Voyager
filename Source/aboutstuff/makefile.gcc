# GNU makefile: voyager_about.vlib with m68k-amigaos-gcc (bebbo toolchain)
#
# make -f makefile.gcc          builds objects/gcc/voyager_about.vlib (and .debug)
# make -f makefile.gcc clean
#
# The library entry (romtag, Open/Close/Expunge) comes from
# ../libstart_gcc.c instead of SAS/C's lib:libent.o + lib:libinit.o.

CROSS    ?= m68k-amigaos-
CC       = $(CROSS)gcc
STRIP    = $(CROSS)strip
CPU      ?= 68020

OBJDIR   = objects/gcc
TARGET   = $(OBJDIR)/voyager_about.vlib

# romtag version from rev.h
LIBVERSION := $(shell awk '/^\#define VERSION[ \t]+[0-9]+[ \t]*$$/ { print $$3 }' rev.h)

INCLUDES = -I. -I.. -I../includestuff
CFLAGS   = -noixemul -m$(CPU) -Os -fomit-frame-pointer -funsigned-char \
	-fno-strict-aliasing -fcommon -Wall -Wno-pointer-sign \
	-Werror=implicit-function-declaration -DAMIGAOS $(INCLUDES)
LDFLAGS  = -noixemul -m$(CPU) -nostartfiles
LIBS     = -lamiga

OBJS = $(OBJDIR)/libstart_gcc.o $(OBJDIR)/about.o $(OBJDIR)/v3logo.o

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(LDFLAGS) -o $(TARGET).debug $(OBJS) $(LIBS)
	$(STRIP) -o $@ $(TARGET).debug

$(OBJDIR)/libstart_gcc.o: ../libstart_gcc.c ../libstart_gcc.h rev.h
	@mkdir -p $(OBJDIR)
	$(CC) $(CFLAGS) -fno-toplevel-reorder -DLIB_VERSION=$(LIBVERSION) -c $< -o $@

$(OBJDIR)/about.o: about.c rev.h ../libstart_gcc.h ../includestuff/macros/compilers.h
	@mkdir -p $(OBJDIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/v3logo.o: ../v3logo.c
	@mkdir -p $(OBJDIR)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(OBJDIR)
